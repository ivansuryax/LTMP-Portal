# Single Render Free web service: React + FastAPI on the same HTTPS origin.
# No runtime Node, no separate static-site domain, no third-party session cookies.
FROM node:22-alpine AS frontend_builder
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
# IMPORTANT: frontend/src/api.js defaults API_ROOT to '' (relative same-origin).
RUN npm run build

FROM python:3.12-slim AS app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SERVE_FRONTEND=true \
    REQUIRE_DATABASE_URL=true \
    COOKIE_SECURE=true
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY backend/scripts ./scripts
COPY --from=frontend_builder /build/frontend/dist /app/frontend/dist
EXPOSE 10000
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips='*'"]
