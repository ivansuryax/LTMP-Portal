# Docker Compose uses the db service hostname. For local Python outside
# Docker set localhost instead, or use sqlite+pysqlite:///./ltmp.db for a demo.
DATABASE_URL=postgresql+psycopg://ltmp:change-this-password@localhost:5432/ltmp
SESSION_SECRET=replace-with-random-long-secret
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
